{
	"name": "@neutrium/decimal",
	"version": "1.1.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src/decimal/**/*.ts",
		"README.md",
		"LICENSE"
	],
	"imports": {
		"#dist/*.js": "./dist/*.js"
	},
	"types": "./dist/index.d.ts",
	"description": "The Neutrium Decimal library.",
	"keywords": [
		"neutrium",
		"math",
		"decimal",
		"numbers"
	],
	"license": "MIT",
	"author": "Trevor Walker <trevorw@neutrium.net> (https://neutrium.net)",
	"private": false,
	"engines": {
		"node": ">=20.19.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/neutrium/decimal.git"
	},
	"bugs": {
		"url": "https://github.com/neutrium/decimal/issues"
	},
	"dependencies": {},
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"tsc": "tsc",
		"build": "npm run tsc",
		"typecheck": "tsc --noEmit",
		"test:types": "npm run build && tsc -p tsconfig.type-tests.json",
		"test:declarations": "npm run build && tsc -p tsconfig.declarations.json",
		"test:package": "npm run build && node scripts/validate-package.mjs",
		"verify": "npm run typecheck && npm run test:types && npm run test:declarations && npm test && npm run test:package",
		"prepack": "npm run clean && npm run build",
		"prepublishOnly": "npm run verify",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"typescript": "^5.9.2",
		"vitest": "^4.1.11"
	}
}
