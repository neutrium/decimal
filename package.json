{
	"name": "@neutrium/decimal",
	"version": "2.0.0",
	"packageManager": "pnpm@10.34.5",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src/**/*.ts",
		"README.md",
		"LICENSE"
	],
	"types": "./dist/index.d.ts",
	"description": "The Neutrium Decimal library.",
	"keywords": [
		"neutrium",
		"math",
		"decimal",
		"numbers"
	],
	"license": "MIT",
	"author": "Trevor Walker <trevorw@neutrium.net> (https://neutrium.net)",
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20.19.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/neutrium/decimal.git"
	},
	"bugs": {
		"url": "https://github.com/neutrium/decimal/issues"
	},
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"tsc": "tsc",
		"build": "pnpm run tsc",
		"benchmark": "pnpm run build && node --expose-gc scripts/benchmark.mjs",
		"benchmark:json": "tsc && node --expose-gc scripts/benchmark.mjs --json",
		"docs": "typedoc",
		"docs:check": "typedoc --emit none",
		"typecheck": "tsc --noEmit",
		"test:architecture": "node scripts/check-architecture.mjs",
		"test:types": "pnpm run build && tsc -p tsconfig.type-tests.json",
		"test:declarations": "pnpm run build && tsc -p tsconfig.declarations.json",
		"test:package": "pnpm run clean && pnpm run build && node scripts/validate-package.mjs",
		"verify": "pnpm run typecheck && pnpm run docs:check && pnpm run test:architecture && pnpm run test:types && pnpm run test:declarations && pnpm test && pnpm run test:package",
		"prepack": "pnpm run clean && pnpm run build",
		"prepublishOnly": "pnpm run verify",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"esbuild": "^0.28.2",
		"typedoc": "0.28.20",
		"typescript": "^5.9.2",
		"vitest": "^4.1.11"
	}
}
