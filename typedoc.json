{
	"$schema": "https://typedoc.org/schema.json",
	"name": "@neutrium/decimal API",
	"entryPoints": [
		"src/index.ts",
		"src/core.ts",
		"src/arithmetic.ts",
		"src/scientific.ts"
	],
	"tsconfig": "tsconfig.json",
	"out": "docs/api",
	"readme": "./README.md",
	"customFooterHtml": "<a href=\"https://neutrium.github.io/decimal/demo/\">Interactive Precision Lab</a>",
	"includeVersion": true,
	"excludeInternal": true,
	"excludePrivate": true,
	"excludeProtected": true,
	"disableSources": false,
	"gitRevision": "master",
	"cleanOutputDir": true,
	"validation": {
		"notExported": true,
		"invalidLink": true,
		"invalidPath": true,
		"rewrittenLink": true,
		"notDocumented": true
	},
	"requiredToBeDocumented": [
		"Class",
		"Interface",
		"Function",
		"Constructor",
		"Property",
		"Method",
		"Accessor",
		"TypeAlias",
		"CallSignature",
		"ConstructorSignature"
	],
	"treatValidationWarningsAsErrors": true
}
