{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"moduleResolution": "node16",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitReturns": true,
		"verbatimModuleSyntax": true,
		"isolatedDeclarations": true,
		"sourceMap": true,
		"inlineSources": true,
		"declaration": true,
		"declarationMap": true,
		"stripInternal": true,
		"outDir": "dist/",
		"lib": [
			"ES2022"
		]
	},
	"files": [
		"./src/decimal/index.ts"
	]
}
